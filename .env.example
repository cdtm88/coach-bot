# Copy to .env and fill in. Never commit .env (SEC-01).
# The canonical list, with what each one gates, lives in docs/setup.md section 4.

# Under docker compose, set POSTGRES_PASSWORD and leave DATABASE_URL alone:
# compose derives the URL from it, and the two disagreeing is a confusing way to
# fail. Generate it with `openssl rand -hex 32` rather than base64 — base64 emits
# `/`, which breaks URI parsing and surfaces as a wrong password.
POSTGRES_PASSWORD=

# Only needed outside compose: running a process directly against some other
# Postgres. Passed verbatim to psycopg, so any libpq URI works. The host here is
# the compose service name, which resolves on the compose network and nowhere
# else; the database has no published port by design (SEC-05).
DATABASE_URL=postgresql://coach:CHANGEME@postgres:5432/coach

# The other way to say the same thing, and the right one when the database was
# deployed separately with its own conventions. Leave DATABASE_URL unset and
# libpq reads these itself: PGHOST, PGPORT, PGUSER, PGDATABASE, PGSSLMODE, and
# PGPASSWORD — which should be exported from a mounted secret file rather than
# written here, so it never lands in a string that `ps` or a traceback can show.
# `coach.db.connect` checks PGHOST to decide which route is configured.
# See docs/deploy-existing-postgres.md.
PGHOST=

# A named-tunnel token from the Cloudflare dashboard. Only read by the
# `cloudflared` service, which is behind the `tunnel` profile — the stack runs
# without it, just unreachable from outside. Needed once MacroLog has to POST in.
CLOUDFLARE_TUNNEL_TOKEN=

# Read by coach.runtime.models, which is the only place a client is constructed.
# coach-agent and coach-scheduler both refuse to start without it, deliberately:
# failing at startup beats going quiet on the athlete's first message.
ANTHROPIC_API_KEY=
# OBS-07's hard stop, enforced in the coach.
DAILY_SPEND_CAP_USD=3.00
# Set at the provider as an alert, deliberately not enforced here: the daily cap
# is a runaway backstop and the monthly is a budget, so they are not proportional
# and the coach only owns the first.
MONTHLY_SPEND_CAP_USD=60.00

# Read by coach.runtime.transport, the only place that talks to Telegram. The
# allowlist below is what SEC-03 enforces and is checked on every message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# HTTP basic, username is the literal string API_KEY and this is the password.
INTERVALS_API_KEY=
# Optional: athlete id 0 resolves to the key owner, which is the default.
INTERVALS_ATHLETE_ID=
# From Manage App on /settings. Unset means every webhook payload is refused.
INTERVALS_WEBHOOK_SECRET=

COACH_INGEST_PORT=8080
# Loopback is right when a process runs directly on a host. Under docker compose
# it must be 0.0.0.0, because cloudflared is a separate container and cannot
# reach the coach's loopback — the compose file sets it and explains why that is
# still narrow (no published port means the compose network only).
COACH_INGEST_HOST=127.0.0.1
# TZ-01: the athlete's zone decides every day and week boundary, whatever the
# server or an upstream feed says. `TZ` at the bottom is the container's; this is
# the one the coach reasons in, and coach.clock.configured_tz is its only reader.
COACH_TZ=Asia/Dubai
# Log level for every long-running process. INFO is the default.
COACH_LOG_LEVEL=INFO
# MEM-12: where the nightly markdown fact export is written.
COACH_EXPORT_DIR=backups

# Where the numbered .sql files live. Only set in the container, where the
# package is installed into site-packages and cannot find them relative to
# itself; from a checkout the default is correct. An empty directory is now a
# hard error rather than a run that applies nothing and says the schema is up
# to date.
COACH_MIGRATIONS_DIR=
# CHAT-02: the persona is a file so changing the coach's voice needs no deploy.
# Defaults to prompts/persona.md; set it to point at a variant.
PERSONA_PATH=prompts/persona.md
COACH_FIT_ARCHIVE=var/fit-archive
COACH_FIT_WATCH=var/fit-inbox

# How often to ask intervals.icu for new activities. This is the primary ingest
# path for anything not arriving through the watched folder, since there is no
# webhook. One API call per poll; a file is downloaded only when something new
# turns up. Floored at 30s in code so a typo cannot burn the daily rate limit.
COACH_POLL_INTERVAL_S=120
# The slow pass: ages out prescriptions nothing satisfied. Floored at 300s.
COACH_SWEEP_INTERVAL_S=21600
# Wellness (body mass and recovery). Its own clock: the feed is written by a
# phone syncing overnight, so it changes once a day. Floored at 300s.
COACH_WELLNESS_INTERVAL_S=3600

# MacroLog posts meals to /macrolog/meals with this in an X-Coach-Secret header.
# Unset means every macro payload is refused. Not the same secret as the
# intervals.icu webhook, deliberately: one leaking must not open the other door.
MACRO_INGEST_SECRET=

# HLTH-05: a target capture rate, never a schedule. There is no weigh in day.
COACH_WEIGH_IN_TARGET_PER_WEEK=2.5
# HLTH-06: the trend window, and how fast a reading inside it loses weight.
COACH_WEIGHT_WINDOW_DAYS=28
COACH_WEIGHT_HALF_LIFE_DAYS=14
# HLTH-11: how far off the fitted trend a reading has to fall before it is held
# for one confirmation. The floor; the scatter of the athlete's own readings
# raises it where they are noisy.
COACH_BODY_MASS_OUTLIER_KG=1.5

# The tunnel hostname MacroLog and any future webhook post to. Used by the setup
# guide and by you when configuring the phone; nothing in src/ reads it.
PUBLIC_BASE_URL=https://coach.yourdomain

# CALR-01: one Google secret iCal address per calendar, comma separated. These
# are bearer secrets — anyone holding one can read that calendar — so they live
# here and nowhere else. They are never written to the database and never logged;
# a redacting filter is installed on httpx's logger because the library logs the
# request URL at INFO on every call.
CALENDAR_ICS_URLS=
# CALR-02's cadence. Six hours; Google publishes these on a cache, so asking more
# often buys nothing. Floored at 900s.
COACH_CALENDAR_INTERVAL_S=21600

# GYM-08: the coefficient that puts gym load on the cycling scale. Session load
# is RPE x duration in minutes x this. A 45 minute session at RPE 7 costs 63,
# which sits about where an hour of endurance riding does. Changing it changes
# the trade between a gym session and a ride without a deploy, which is the
# requirement's acceptance criterion.
COACH_GYM_LOAD_COEFFICIENT=0.20
# BLOCK-07: how much planned weekly load may rise against the week before, on
# the combined scale. Ten percent is conventional and is on the permissive side
# for a de-trained athlete with an L5-S1 repair.
COACH_WEEKLY_LOAD_RAMP_PCT=10
# GYM-03: what the gym actually has. The apartment building gym is a deliberate
# adherence choice until roughly 105 kg, so this changes once.
COACH_GYM_EQUIPMENT=bodyweight,band,dumbbell

# The container's timezone. COACH_TZ above is what the coach actually reasons in;
# this one only affects what a log line looks like.
TZ=Asia/Dubai
